# Copy to .env and paste the keys you have. Every key is optional: without one, that feature
# falls back to the offline workbook data and the app still works.

# GPT-4o for the Planner, the specialists' choices and the written answers
OPENAI_API_KEY=

# Live data (see README "Live data" for where to get each key)
GOOGLE_PLACES_API_KEY=     # current hours, open/closed, price level, website, phone, parking (Google Cloud, billing on)
TICKETMASTER_API_KEY=      # real concerts / games / shows on your date (free: developer.ticketmaster.com)
TAVILY_API_KEY=            # web search for menus, discounts, website summaries (free tier: tavily.com)
TOMTOM_API_KEY=            # drive times with live traffic (free tier: developer.tomtom.com)

# Visitors can also paste their own key in the app (🔑 button); it stays in their session only.
# AZ_REQUIRE_USER_KEY=1   # public deployments: never use the server's OPENAI_API_KEY for visitors
# AZ_LLM_MODEL=gpt-4o
# AZ_OFFLINE=1        # force everything offline (tests, demos without internet)
# AZ_WEATHER=off      # turn off the Open-Meteo forecast
